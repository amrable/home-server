      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "export default async function() {\n  const completion = $input.first().json.choices[0].message.content;\n  let data = {};\n  try { data = JSON.parse(completion); } catch { data = { raw: completion }; }\n  return [{ json: data }];\n}"
      },
      "id": "parse-llm",
      "name": "Parse Summary",
      "type": "n8n-nodes-base.code",
