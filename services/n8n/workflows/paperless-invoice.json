        "jsonBody": "={ model: \"openai/gpt-4o-mini:json\", messages: [ { role: \"system\", content: \"Extract the following fields from the invoice text as strict JSON (no markdown, no extra text): vendor, invoice_number, amount, currency, invoice_date, due_date, description. Never guess - use null when a field cannot be determined.\" }, { role: \"user\", content: $json.content } ] }",
        "options": {}
      },
