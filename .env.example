# Tailscale auth key (from https://login.tailscale.com/admin/settings/keys)
# Use an auth key with "Subnet routes" enabled so it can advertise HOMESERVER_SUBNET.
TS_AUTHKEY=

HOMESERVER_SUBNET=172.20.0.0/24

NEXTCLOUD_IP=172.20.0.11
JELLYFIN_IP=172.20.0.12
IMMICH_IP=172.20.0.13
VAULTWARDEN_IP=172.20.0.14
TAILSCALE_IP=172.20.0.2

# Vaultwarden is served over HTTPS via `tailscale serve` (Bitwarden clients require HTTPS).
# TAILNET_DOMAIN is your tailnet's MagicDNS suffix, e.g. my-tailnet.ts.net
# (Tailscale admin console -> DNS). TAILSCALE_HOSTNAME is the `hostname` in the
# tailscale compose service.
TAILSCALE_HOSTNAME=home
TAILNET_DOMAIN=

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=changeme
IMMICH_DB_DATABASE=immich

VAULTWARDEN_ADMIN_TOKEN=changeme

DATA_PATH=/mnt/data