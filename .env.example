# Tailscale reusable auth key (from https://login.tailscale.com/admin/settings/keys)
# Must be REUSABLE: every service runs its own tailscale sidecar machine.
TS_AUTHKEY=

# Your tailnet's MagicDNS suffix (Tailscale admin console -> DNS),
# e.g. my-tailnet.ts.net. Services are reachable as
# https://cloud|media|photos|vault.<TAILNET_DOMAIN>
TAILNET_DOMAIN=

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=changeme
IMMICH_DB_DATABASE=immich

VAULTWARDEN_ADMIN_TOKEN=changeme

PAPERLESS_DB_USERNAME=paperless
PAPERLESS_DB_PASSWORD=changeme
PAPERLESS_DB_DATABASE=paperless
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
PAPERLESS_ADMIN_MAIL=admin@example.com
PAPERLESS_SECRET_KEY=changeme

DATA_PATH=/mnt/data